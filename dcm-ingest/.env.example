# =============================================================================
#  DAILY CRYPTO MEDIA — CONTOH KONFIGURASI LINGKUNGAN
#  Salin menjadi .env lalu isi nilainya. Jangan commit berkas .env.
# =============================================================================

# --- Wajib -------------------------------------------------------------------
# Kunci API dari https://console.anthropic.com
DCM_ANTHROPIC_API_KEY=sk-ant-...

# --- Basis data --------------------------------------------------------------
# SQLite cukup untuk pengembangan dan situs bertrafik sedang.
# Untuk produksi: postgresql+psycopg://user:sandi@host:5432/dcm
DCM_DATABASE_URL=sqlite:///dcm.db

# --- Terjemahan --------------------------------------------------------------
# claude-sonnet-5 untuk kualitas judul terbaik.
# claude-haiku-4-5-20251001 jauh lebih murah; bandingkan hasilnya lebih dulu
# pada 50 judul sebelum memindahkan seluruh volume ke sana.
DCM_TRANSLATE_MODEL=claude-sonnet-5
DCM_TRANSLATE_BATCH_SIZE=8

# --- Pengambilan -------------------------------------------------------------
DCM_POLL_INTERVAL_MINUTES=10
DCM_FETCH_CONCURRENCY=4

# --- Penyaringan -------------------------------------------------------------
# Artikel di bawah skor ini tidak tayang. Naikkan bila halaman depan terasa
# terlalu ramai, turunkan bila terlalu sepi.
DCM_MIN_PUBLISH_SCORE=20
DCM_DEDUPE_SIMILARITY_THRESHOLD=0.82
DCM_MAX_ARTICLE_AGE_DAYS=14

# --- API ---------------------------------------------------------------------
DCM_API_HOST=127.0.0.1
DCM_API_PORT=8000
DCM_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500,http://127.0.0.1:5500,https://dailycryptomedia.id
